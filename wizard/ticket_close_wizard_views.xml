<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ticket_close_wizard_form" model="ir.ui.view">
        <field name="name">ticket.close.wizard.form</field>
        <field name="model">helpdesk.ticket.close.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="ticket_id" invisible="1"/>
                    <field name="resolution_note"/>
                </group>
                <footer>
                    <button string="Close Ticket" name="action_close_ticket" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
