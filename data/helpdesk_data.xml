<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_helpdesk_ticket" model="ir.sequence">
            <field name="name">Helpdesk Ticket</field>
            <field name="code">helpdesk.ticket</field>
            <field name="prefix">TKT-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
        </record>

        <record id="stage_new" model="helpdesk.stage">
            <field name="name">جديد / New</field>
            <field name="sequence">1</field>
        </record>

        <record id="stage_progress" model="helpdesk.stage">
            <field name="name">قيد المعالجة / In Progress</field>
            <field name="sequence">5</field>
        </record>

        <record id="stage_solved" model="helpdesk.stage">
            <field name="name">تم الحل / Solved</field>
            <field name="sequence">10</field>
        </record>

        <record id="stage_closed" model="helpdesk.stage">
            <field name="name">مغلق / Closed</field>
            <field name="sequence">20</field>
            <field name="fold" eval="True"/>
            <field name="is_closed" eval="True"/>
        </record>

        <record id="team_support" model="helpdesk.team">
            <field name="name">الدعم الفني / Support Team</field>
            <field name="show_in_portal" eval="True"/>
        </record>
    </data>
</odoo>
