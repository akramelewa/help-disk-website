<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Survey Email Template -->
        <record id="mail_template_customer_survey" model="mail.template">
            <field name="name">Helpdesk: Customer Survey</field>
            <field name="model_id" ref="model_helpdesk_ticket"/>
            <field name="subject">📊 كيف كانت تجربتك معنا؟ - Ticket #${object.ticket_number or ''}</field>
            <field name="email_to">${object.partner_email or ''}</field>
            <field name="body_html" type="html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; background-color: #f5f5f5; padding: 20px;">
    <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 30px; text-align: center; border-radius: 10px 10px 0 0;">
        <h1 style="color: white; margin: 0; font-size: 28px;">⭐ كيف كانت تجربتك؟</h1>
        <p style="color: #f0f0f0; margin: 10px 0 0 0; font-size: 16px;">We Value Your Feedback!</p>
    </div>
    <div style="background: white; padding: 30px; border-radius: 0 0 10px 10px;">
        <p style="font-size: 16px; color: #333;">عزيزي/عزيزتي <strong>${object.partner_id.name or ''}</strong>،</p>
        <p style="font-size: 14px; color: #666; line-height: 1.6;">تم إغلاق تذكرتك بنجاح. نود معرفة رأيك في خدمتنا.</p>
        <div style="background: #f8f9ff; border-left: 4px solid #667eea; padding: 20px; margin: 20px 0; border-radius: 5px;">
            <p style="margin: 5px 0;"><strong>رقم التذكرة:</strong> ${object.ticket_number or ''}</p>
            <p style="margin: 5px 0;"><strong>الموضوع:</strong> ${object.name or ''}</p>
        </div>
        <p style="font-size: 14px; color: #666;">يرجى تخصيص دقيقة واحدة لتقييم خدمتنا:</p>
        <div style="text-align: center; margin: 30px 0;">
            <a href="${ctx.get('base_url', '')}/helpdesk/survey/${object.id}?token=${object.survey_token or ''}" 
               style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 15px 40px; text-decoration: none; border-radius: 25px; display: inline-block; font-weight: bold;">
                ⭐ قيّم الخدمة الآن
            </a>
        </div>
        <p style="font-size: 12px; color: #999; text-align: center;">سيستغرق الأمر أقل من دقيقة</p>
    </div>
    <div style="text-align: center; padding: 20px; color: #999; font-size: 12px;">
        <p>© Tamkeen Helpdesk Pro</p>
    </div>
</div>
]]></field>
        </record>
    </data>
</odoo>