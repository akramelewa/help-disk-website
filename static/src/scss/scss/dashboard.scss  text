.o_helpdesk_dashboard {
    padding: 20px;
    background: #f3f4f6;
    min-height: 100vh;

    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        background: white;
        padding: 20px;
        border-radius: 15px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);

        h1 {
            font-size: 24px;
            font-weight: 700;
            margin: 0;
        }
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: white;
        padding: 25px;
        border-radius: 16px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        transition: transform 0.2s;

        &:hover {
            transform: translateY(-5px);
        }

        .stat-info {
            h3 {
                font-size: 14px;
                color: #64748b;
                margin-bottom: 10px;
                font-weight: 600;
            }

            .value {
                font-size: 32px;
                font-weight: 700;
                color: #1e293b;
            }

            .trend {
                margin-top: 10px;
                font-size: 12px;
                color: #10b981;

                i {
                    margin-right: 5px;
                }
            }
        }

        .stat-icon {
            width: 50px;
            height: 50px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
        }
    }

    .charts-container {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 20px;
        margin-bottom: 30px;

        @media (max-width: 1024px) {
            grid-template-columns: 1fr;
        }
    }

    .chart-card {
        background: white;
        padding: 25px;
        border-radius: 16px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);

        .chart-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;

            .chart-title {
                font-size: 18px;
                font-weight: 700;
            }
        }
    }

    .recent-tickets {
        background: white;
        padding: 25px;
        border-radius: 16px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        overflow-x: auto;

        table {
            width: 100%;
            border-collapse: collapse;

            th, td {
                text-align: right;
                padding: 15px;
                border-bottom: 1px solid #f1f5f9;
            }

            th {
                color: #64748b;
                font-weight: 600;
                font-size: 14px;
            }

            .ticket-row {
                cursor: pointer;
                transition: background 0.2s;

                &:hover {
                    background: #f8fafc;
                }
            }

            .status-badge {
                padding: 6px 12px;
                border-radius: 20px;
                font-size: 12px;
                font-weight: 600;
            }

            .status-open {
                background: #e0f2fe;
                color: #0284c7;
            }

            .status-closed {
                background: #dcfce7;
                color: #16a34a;
            }
        }
    }
}