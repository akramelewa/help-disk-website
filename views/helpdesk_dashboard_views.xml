<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Stats Dashboard -->
    <record id="view_helpdesk_dashboard_kanban" model="ir.ui.view">
        <field name="name">helpdesk.dashboard.kanban</field>
        <field name="model">helpdesk.team</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_dashboard o_helpdesk_kanban">
                <field name="name"/>
                <field name="member_ids"/>
                
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click o_kanban_dashboard">
                            <div class="o_kanban_card_header">
                                <div class="o_kanban_card_header_title">
                                    <div class="o_primary">
                                        <strong><field name="name"/></strong>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="container o_kanban_card_content o_visible">
                                <div class="row">
                                    <div class="col-12 o_kanban_primary_left">
                                        <button class="btn btn-primary btn-block" name="%(action_helpdesk_ticket)d" type="action" context="{'default_team_id': active_id}">
                                            <i class="fa fa-plus"/> إنشاء تذكرة جديدة
                                        </button>
                                    </div>
                                </div>
                                
                                <div class="row mt-3">
                                    <div class="col-12">
                                        <button class="btn btn-secondary btn-block" name="%(action_helpdesk_ticket)d" type="action" context="{'search_default_team_id': active_id}">
                                            <i class="fa fa-list"/> عرض جميع التذاكر
                                        </button>
                                    </div>
                                </div>
                                
                                <div class="row mt-3">
                                    <div class="col-12">
                                        <div class="text-muted">
                                            <i class="fa fa-users"/> 
                                            <strong><t t-esc="record.member_ids.raw_value.length"/> عضو</strong>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Dashboard Action -->
    <record id="action_helpdesk_dashboard" model="ir.actions.act_window">
        <field name="name">لوحة التحكم</field>
        <field name="res_model">helpdesk.team</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                إنشاء فريق دعم فني
            </p>
            <p>
                ابدأ بإنشاء فريق جديد لإدارة التذاكر
            </p>
        </field>
    </record>
</odoo>