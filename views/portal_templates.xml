<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_menu_tickets" name="Portal: Tickets Menu" inherit_id="portal.portal_my_home" priority="30">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">تذاكر الدعم</t>
                <t t-set="url" t-value="'/my/tickets'"/>
                <t t-set="placeholder_count" t-value="'ticket_count'"/>
            </t>
        </xpath>
    </template>

    <template id="portal_my_tickets" name="My Tickets">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <div class="container mt-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3><i class="fa fa-ticket-alt"/> تذاكر الدعم / Support Tickets</h3>
                    <a href="/helpdesk" class="btn btn-primary"><i class="fa fa-plus"/> تذكرة جديدة</a>
                </div>

                <t t-if="not tickets">
                    <div class="alert alert-info text-center py-5">
                        <i class="fa fa-inbox" style="font-size: 60px;"/>
                        <h4 class="mt-3">لا توجد تذاكر بعد</h4>
                        <a href="/helpdesk" class="btn btn-primary mt-2">إنشاء أول تذكرة</a>
                    </div>
                </t>

                <t t-if="tickets">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>الرقم</th>
                                <th>الموضوع</th>
                                <th>الحالة</th>
                                <th>التاريخ</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="tickets" t-as="ticket">
                                <tr>
                                    <td><strong><t t-esc="ticket.ticket_number"/></strong></td>
                                    <td><t t-esc="ticket.name"/></td>
                                    <td>
                                        <span t-attf-class="badge {{ticket.is_closed and 'bg-secondary' or 'bg-primary'}}">
                                            <t t-esc="ticket.stage_id.name"/>
                                        </span>
                                    </td>
                                    <td><t t-esc="ticket.create_date" t-options="{'widget': 'date'}"/></td>
                                    <td>
                                        <a t-attf-href="/my/ticket/{{ticket.id}}" class="btn btn-sm btn-outline-primary">
                                            <i class="fa fa-eye"/> عرض
                                        </a>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>
            </div>
        </t>
    </template>

    <template id="portal_ticket_page" name="Ticket Details">
        <t t-call="portal.portal_layout">
            <div class="container mt-4">
                <div class="card shadow">
                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0"><i class="fa fa-ticket-alt"/> <t t-esc="ticket.ticket_number"/></h4>
                    </div>
                    <div class="card-body">
                        <h3><t t-esc="ticket.name"/></h3>
                        <div class="row mt-3">
                            <div class="col-md-6">
                                <p><strong><i class="fa fa-user"/> العميل:</strong> <t t-esc="ticket.partner_id.name"/></p>
                                <p><strong><i class="fa fa-envelope"/> البريد:</strong> <t t-esc="ticket.partner_email"/></p>
                            </div>
                            <div class="col-md-6">
                                <p><strong><i class="fa fa-users"/> الفريق:</strong> <t t-esc="ticket.team_id.name"/></p>
                                <p>
                                    <strong><i class="fa fa-flag"/> الحالة:</strong> 
                                    <span t-attf-class="badge {{ticket.is_closed and 'bg-secondary' or 'bg-success'}}">
                                        <t t-esc="ticket.stage_id.name"/>
                                    </span>
                                </p>
                            </div>
                        </div>
                        <hr/>
                        <h5><i class="fa fa-align-left"/> الوصف:</h5>
                        <div class="mt-2" t-field="ticket.description"/>
                        <div class="mt-4">
                            <a href="/my/tickets" class="btn btn-secondary"><i class="fa fa-arrow-left"/> العودة</a>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
    <template id="website_helpdesk_page" name="Submit Ticket">
    <t t-call="website.layout">
        <div id="wrap" class="oe_structure">
            <div class="container mt-5 mb-5">
                <div class="row">
                    <div class="col-lg-8 offset-lg-2">
                        <div class="card shadow-lg">
                            <div class="card-header bg-primary text-white text-center py-4">
                                <h2 class="mb-1"><i class="fa fa-headset"/> إرسال تذكرة دعم</h2>
                                <p class="mb-0">Submit Support Ticket</p>
                            </div>
                            <div class="card-body p-4">
                                <!-- Get user info if logged in -->
                                <t t-set="current_user" t-value="request.env.user"/>
                                <t t-set="is_logged_in" t-value="current_user.id != request.env.ref('base.public_user').id"/>
                                <t t-set="partner" t-value="current_user.partner_id if is_logged_in else None"/>
                                
                                <!-- Show welcome message if logged in -->
                                <t t-if="is_logged_in">
                                    <div class="alert alert-info mb-4">
                                        <i class="fa fa-user-circle"/> مرحباً <strong><t t-esc="partner.name"/></strong>! 
                                        تم ملء بياناتك تلقائياً من حسابك.
                                    </div>
                                </t>
                                
                                <form action="/helpdesk/submit" method="POST" id="helpdesk_form">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label required"><i class="fa fa-user"/> الاسم / Name</label>
                                            <input type="text" 
                                                   name="name" 
                                                   class="form-control form-control-lg" 
                                                   placeholder="أدخل اسمك" 
                                                   required="required"
                                                   t-att-value="partner.name if is_logged_in else ''"
                                                   t-att-readonly="'readonly' if is_logged_in else None"/>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label required"><i class="fa fa-envelope"/> البريد / Email</label>
                                            <input type="email" 
                                                   name="email" 
                                                   class="form-control form-control-lg" 
                                                   placeholder="example@email.com" 
                                                   required="required"
                                                   t-att-value="partner.email if is_logged_in else ''"
                                                   t-att-readonly="'readonly' if is_logged_in else None"/>
                                        </div>
                                    </div>
                                    
                                    <div class="mb-3">
                                        <label class="form-label"><i class="fa fa-phone"/> الهاتف / Phone</label>
                                        <input type="tel" 
                                               name="phone" 
                                               class="form-control form-control-lg" 
                                               placeholder="+966 XX XXX XXXX"
                                               t-att-value="partner.phone if is_logged_in and partner.phone else ''"/>
                                    </div>
                                    
                                    <div class="mb-3">
                                        <label class="form-label required"><i class="fa fa-tag"/> الموضوع / Subject</label>
                                        <input type="text" name="subject" class="form-control form-control-lg" placeholder="موضوع التذكرة" required="required"/>
                                    </div>
                                    
                                    <div class="mb-4">
                                        <label class="form-label required"><i class="fa fa-comment-alt"/> الوصف / Description</label>
                                        <textarea name="description" class="form-control" rows="6" placeholder="اشرح المشكلة..." required="required"/>
                                    </div>
                                    
                                    <div class="text-center">
                                        <button type="submit" class="btn btn-primary btn-lg px-5 py-3">
                                            <i class="fa fa-paper-plane"/> إرسال / Submit
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <script>
            document.getElementById('helpdesk_form').addEventListener('submit', function(e) {
                var btn = this.querySelector('button[type="submit"]');
                btn.disabled = true;
                btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> جاري الإرسال...';
            });
        </script>
    </t>
</template>
</odoo>