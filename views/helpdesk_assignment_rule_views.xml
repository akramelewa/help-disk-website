<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_helpdesk_assignment_rule_form" model="ir.ui.view">
        <field name="name">helpdesk.assignment.rule.form</field>
        <field name="model">helpdesk.assignment.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options="{'terminology': 'archive'}"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name" placeholder="e.g. Urgent Tickets - Round Robin"/>
                            <field name="team_id"/>
                            <field name="priority"/>
                        </group>
                        <group>
                            <field name="assignment_method"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <group string="Assign To">
                        <field name="user_ids" widget="many2many_tags" placeholder="Leave empty to use all team members"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_helpdesk_assignment_rule_tree" model="ir.ui.view">
        <field name="name">helpdesk.assignment.rule.tree</field>
        <field name="model">helpdesk.assignment.rule</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="team_id"/>
                <field name="priority"/>
                <field name="assignment_method"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- Action -->
    <record id="action_helpdesk_assignment_rule" model="ir.actions.act_window">
        <field name="name">Assignment Rules</field>
        <field name="res_model">helpdesk.assignment.rule</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>